// Windows resources: exe icon + version info
1 ICON "../assets/branding/dna-editor.ico"
1 VERSIONINFO
FILEVERSION 0,0,2,0
PRODUCTVERSION 0,0,2,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "mghost99"
      VALUE "FileDescription", "DNA Editor"
      VALUE "ProductName", "DNA Editor"
      VALUE "FileVersion", "0.0.2"
      VALUE "ProductVersion", "0.0.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
