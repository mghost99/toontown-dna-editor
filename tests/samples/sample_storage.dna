// Hand-written sample storage file for the DNA editor tests (no game data).
/* block comment
   spanning lines */
model "phase_4/models/props/sample_props" [
  store_node [ "prop" "prop_sample_tree" "tree" ]
  store_node [ "prop" "prop_sample_lamp" ]
]
hood_model "phase_4/models/modules/sample_walls" [
  store_node [ "wall" "wall_sample_ur" ]
]
place_model "phase_4/models/modules/sample_landmark" [
  store_node [ "toon_landmark" "toon_landmark_sample" "" ]
]
store_texture [ "texture" "street_sample_tex" "phase_4/maps/sample_street.jpg" ]
store_texture [ "sample_untyped_tex" "phase_4/maps/sample2.jpg" ]
store_font [ "font" "sample_font" "phase_3/models/fonts/SampleFont" ]
