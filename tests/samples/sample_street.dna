// Hand-written sample street for the DNA editor tests.
// Every component type the editor knows, plus a comment the save must keep.
store_suit_point [ 1, STREET_POINT, 10 -20 0 ]
store_suit_point [ 2, FRONT_DOOR_POINT, 15.5 -20 0, 3 ]
group "sample_street" [
  visgroup "9101" [
    vis [ "9101" "9102" ]
    suit_edge [ 1 2 ]
    battle_cell [ 20 20 12.5 -20 -0.5 ]
    // a lone tree; the test moves it
    prop "prop_sample_tree_DNARoot" [
      code [ "prop_sample_tree" ]
      pos [ 5 10 0 ]
      hpr [ 90 0 0 ]
      scale [ 1.25 1.25 1.25 ]
      color [ 1 0.5 0.25 1 ]
    ]
    prop "prop_sample_lamp_DNARoot" [
      code [ "prop_sample_lamp" ]
      pos [ -5 10 0 ]
    ]
    anim_prop "animated_prop_sample_DNARoot" [
      code [ "prop_sample_lamp" ]
      anim [ "sample_idle" ]
      pos [ 0 0 0 ]
      nhpr [ 0 0 0 ]
    ]
    interactive_prop "interactive_prop_sample_DNARoot" [
      code [ "prop_sample_lamp" ]
      anim [ "sample_idle" ]
      cell_id [ 0 ]
      pos [ 1 2 3 ]
      nhpr [ 45 0 0 ]
    ]
    street "street_sample_DNARoot" [
      code [ "street_sample" ]
      pos [ 0 0 0 ]
      nhpr [ 0 0 0 ]
      texture [ "street_sample_tex" ]
      texture [ "street_sample_tex" ]
      texture [ "street_sample_tex" ]
      color [ 1 1 1 1 ]
    ]
    flat_building "tb2:random_DNARoot" [
      pos [ 20 0 0 ]
      nhpr [ 180 0 0 ]
      width [ 15 ]
      wall [
        height [ 10 ]
        code [ "wall_sample_ur" ]
        color [ 0.9 0.8 0.7 1 ]
        flat_door [
          code [ "door_sample" ]
          color [ 1 0.87 0.38 1 ]
        ]
      ]
      wall [
        height [ 10 ]
        code [ "wall_sample_ur" ]
        color [ 0.9 0.8 0.7 1 ]
        windows [
          code [ "window_sample" ]
          color [ 0.1 0.6 0.3 1 ]
          count [ 2 ]
        ]
        cornice [
          code [ "cornice_sample" ]
          color [ 0.9 0.7 0.6 1 ]
        ]
      ]
    ]
    landmark_building "tb3:toon_landmark_sample_DNARoot" [
      code [ "toon_landmark_sample" ]
      title [ "Sample Shop" ]
      article [ "the" ]
      building_type [ "gagshop" ]
      pos [ -20 0 0 ]
      nhpr [ 0 0 0 ]
      door [
        code [ "door_sample" ]
        color [ 0.88 0.45 0.38 1 ]
      ]
      sign [
        code [ "sample_sign" ]
        pos [ 0 -0.5 10 ]
        baseline [
          code [ "sample_font" ]
          color [ 0.7 0 0.1 1 ]
          flags [ "b" ]
          kern [ 0.05 ]
          width [ 20 ]
          height [ 20 ]
          pos [ 0 0 0.7 ]
          scale [ 1.3 1 1.2 ]
          text [
            letters [ "SAMPLE" ]
          ]
          graphic [
            code [ "sample_graphic" ]
            width [ 2 ]
            height [ 1.5 ]
          ]
        ]
      ]
    ]
    node "sample_node" [
      pos [ 0 30 0 ]
      prop "prop_nested_DNARoot" [
        code [ "prop_sample_tree" ]
        pos [ 1 1 0 ]
      ]
    ]
  ]
]
